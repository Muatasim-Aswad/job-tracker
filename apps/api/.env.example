# ? Local defaults work out of the box; copy to .env only to override.

# DB_PATH=jobtracker.db
# PORT=3456

# ? Output root for the standalone scripts/ maintenance tools (merge-log.md,
# ? no-jd-listings.md, ...). Defaults to a repo-relative script-output/ dir.
# SCRIPTS_OUTPUT_DIR=script-output

# ? Needs-attention thresholds, measured in whole days since the newest
# ? status-setting event (including a correction) or note. Only applied and
# ? in-process jobs participate. Zero disables attention for that stage; the
# ? server only suggests review and never marks a job ghosted automatically.

# ATTENTION_APPLIED_DAYS=21
# ATTENTION_IN_PROCESS_DAYS=14

# ? Security (see apps/api/README.md's Security section). Defaults are proportionate
# ? to a localhost-only personal tool: no API key, CORS allowlisting only the Vite
# ? dev origin + the extension's fixed chrome-extension:// origin, and a
# ? TrustedHostMiddleware allowlist of localhost/127.0.0.1. Override only if you
# ? change how/where this server is reached. Keep API_KEY unset for direct local
# ? use: the dashboard and extension do not send X-API-Key themselves. If set,
# ? every direct /api request from either client receives 401 unless a trusted
# ? intermediary injects the header before forwarding the request.

# API_KEY=
# WEB_DEV_ORIGIN=http://localhost:5173
# EXTENSION_ID=kepjjdggnlkcnedgabpknmpnknblokil
# TRUSTED_HOSTS=["localhost","127.0.0.1"]

# ? Set these once the Turso remote primary exists to enable cross-device sync.

# TURSO_DATABASE_URL=libsql://job-tracker-<org>.turso.io
# TURSO_AUTH_TOKEN=

# ? Local-first (pyturso) mode: reads AND writes are local/instant; local changes are
# ? pushed to the primary in the background (debounced), and the primary is pulled on
# ? startup and then every TURSO_PULL_INTERVAL_SECONDS so another laptop's writes show
# ? up without a restart. This is the recommended mode for the single-user desktop
# ? case. Leave false to use the libSQL embedded replica instead (reads local, writes
# ? write-through to the primary).

# TURSO_LOCAL_FIRST=true
# TURSO_PUSH_DEBOUNCE_SECONDS=4.0
# TURSO_HTTP_TIMEOUT_SECONDS=10.0

# ? Remote-pull cadence, in seconds. Drives libSQL's sync_interval when
# ? Turso_local_first is false, and the pyturso background pull loop when it is true.
# TURSO_PULL_INTERVAL_SECONDS=60

# ? Testing against a real (throwaway) Turso DB. Set APP_ENV=test to point the app
# ? at TURSO_TEST_* instead of the vars above, and relocate the local replica files
# ? under .test-db/ so prod data and prod replica files are never touched. The same
# ? TURSO_TEST_* vars back the `turso`-marked integration tests (run: pytest -m turso;
# ? excluded from a plain `pytest`). Always a disposable DB, never the real primary.

# APP_ENV=test
# TURSO_TEST_DATABASE_URL=libsql://job-tracker-TEST-<org>.turso.io
# TURSO_TEST_AUTH_TOKEN=
