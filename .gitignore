# JavaScript and build output
node_modules/
dist/

# Local environment files
*.local
.env
.env.*
!.env.example

# Python / uv
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local API data
apps/api/**/*.db
apps/api/**/*.db-*
apps/api/**/*.db.sync*
apps/api/**/backups/
apps/api/.job-tracker-state/
apps/api/script-output/

# Private overlays — absent from the public build (see docs/PRIVATE.md)
apps/extension/src/adapters/local/
apps/web/src/platforms/local/
apps/api/scripts/local/

# Plans/ledgers hold internal context. Existing tracked files remain tracked;
# this rule prevents a fresh export from staging them.
docs/plans/
